# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it's in .gitignore.

# ==========================================
# REQUIRED — App won't start without these
# ==========================================

# AI Teacher — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=""

# Database — neon.tech → Connection Details (pooled)
DATABASE_URL=""
# Direct (non-pooler) connection — used by Prisma migrations
DIRECT_URL=""

# Cache + Rate limiting — console.upstash.com → REST API tab
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Auth — run: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ==========================================
# VOICE FEATURES — Optional for local dev
# ==========================================

# Speech-to-Text — console.groq.com/keys (free tier)
GROQ_API_KEY=""

# Pronunciation scoring — Azure portal → Speech Service → F0 free tier
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastus"

# Teacher voice (Phase 2) — Google Cloud Console → TTS API
GOOGLE_CLOUD_TTS_API_KEY=""

# Audio storage — supabase.com → Settings → API
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ==========================================
# PAYMENTS + SOCIAL LOGIN — Phase 3 only
# ==========================================

STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
